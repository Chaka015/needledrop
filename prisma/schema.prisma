generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String           @id @default(cuid())
  clerkId             String           @unique
  username            String           @unique
  bio                 String?
  createdAt           DateTime         @default(now())
  avatarUrl           String?
  nowSpinning         String?
  skin                String?
  nowSpinningSource   String?
  spotifyAccessToken  String?
  spotifyId           String?
  spotifyRefreshToken String?
  spotifyTokenExpiry  DateTime?
  feedPreferences     Json?
  nowSpinningAt       DateTime?
  spotifyConnected    Boolean          @default(false)
  spotifyConnectedAt  DateTime?
  spotifyLastSyncedAt DateTime?
  isPremium           Boolean          @default(false)
  premiumSince        DateTime?
  stripeCustomerId    String?          @unique
  stripeSubId         String?          @unique
  albumComments       AlbumComment[]
  audioSetup          AudioSetup?
  collection          Collection[]
  CommentSpin         CommentSpin[]
  following           Follow[]         @relation("follower")
  followers           Follow[]         @relation("following")
  logs                ListeningLog[]
  mixes               Mix[]
  notifications       Notification[]
  showAttendance      ShowAttendance[]
  spins               Spin[]
  wantlist            Wantlist[]
  sentMessages        Message[]        @relation("MessageFrom")
  receivedMessages    Message[]        @relation("MessageTo")
}

model Message {
  id        String   @id @default(cuid())
  fromId    String
  toId      String
  content   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  from      User     @relation("MessageFrom", fields: [fromId], references: [id])
  to        User     @relation("MessageTo", fields: [toId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  fromId    String?
  logId     String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  url       String?
  user      User     @relation(fields: [userId], references: [id])
}

model Album {
  id            String         @id @default(cuid())
  discogsId     String         @unique
  title         String
  artist        String
  releaseYear   Int?
  coverUrl      String?
  label         String?
  genre         String?
  artistMbid    String?
  durationMs    BigInt?
  mbid          String?
  catalogNumber String?
  formats       Json?
  genreTags     Json?
  genres        String[]
  spotifyId     String?
  isInCatalog   Boolean        @default(false)
  visibility    String         @default("hidden")
  comments      AlbumComment[]
  collection    Collection[]
  logs          ListeningLog[]
  mixItems      MixItem[]
  wantlist      Wantlist[]
}

model Spin {
  id        String       @id @default(cuid())
  userId    String
  logId     String
  createdAt DateTime     @default(now())
  log       ListeningLog @relation(fields: [logId], references: [id])
  user      User         @relation(fields: [userId], references: [id])

  @@unique([userId, logId])
}

model Collection {
  id         String   @id @default(cuid())
  userId     String
  albumId    String
  condition  String?
  addedAt    DateTime @default(now())
  isFeatured Boolean  @default(false)
  pressingId String?
  album      Album    @relation(fields: [albumId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, albumId])
}

model ListeningLog {
  id           String   @id @default(cuid())
  userId       String
  albumId      String
  rating       Float?
  review       String?
  format       String?
  playedAt     DateTime @default(now())
  source       String   @default("physical")
  autoImported Boolean  @default(false)
  durationMs   BigInt?
  album        Album    @relation(fields: [albumId], references: [id])
  user         User     @relation(fields: [userId], references: [id])
  spins        Spin[]
}

model Wantlist {
  id      String   @id @default(cuid())
  userId  String
  albumId String
  addedAt DateTime @default(now())
  album   Album    @relation(fields: [albumId], references: [id])
  user    User     @relation(fields: [userId], references: [id])

  @@unique([userId, albumId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("follower", fields: [followerId], references: [id])
  following   User     @relation("following", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
}

model AudioSetup {
  id        String  @id @default(cuid())
  userId    String  @unique
  turntable String?
  preamp    String?
  speakers  String?
  photoUrl  String?
  user      User    @relation(fields: [userId], references: [id])
}

model Mix {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?
  coverUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  isPublic    Boolean   @default(true)
  user        User      @relation(fields: [userId], references: [id])
  items       MixItem[]
}

model MixItem {
  id       String  @id @default(cuid())
  mixId    String
  albumId  String
  position Int
  note     String?
  album    Album   @relation(fields: [albumId], references: [id])
  mix      Mix     @relation(fields: [mixId], references: [id], onDelete: Cascade)

  @@unique([mixId, albumId])
  @@unique([mixId, position])
}

model AlbumComment {
  id          String         @id @default(cuid())
  userId      String
  albumId     String
  content     String
  createdAt   DateTime       @default(now())
  deleted     Boolean        @default(false)
  parentId    String?
  updatedAt   DateTime       @default(now())
  album       Album          @relation(fields: [albumId], references: [id])
  parent      AlbumComment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies     AlbumComment[] @relation("CommentReplies")
  user        User           @relation(fields: [userId], references: [id])
  CommentSpin CommentSpin[]
}

model ShowAttendance {
  id          String   @id @default(cuid())
  userId      String
  setlistFmId String
  artistMbid  String
  venueName   String
  venueCity   String
  showDate    DateTime
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@unique([userId, setlistFmId])
}

model CommentSpin {
  id           String       @id
  userId       String
  commentId    String
  createdAt    DateTime     @default(now())
  AlbumComment AlbumComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  User         User         @relation(fields: [userId], references: [id])

  @@unique([userId, commentId])
}
