generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  clerkId      String   @unique
  username     String   @unique
  notifications Notification[]
  bio          String?
  avatarUrl    String?
  nowSpinning  String?  // albumId of currently playing album
  nowSpinningSource String? // "physical" | "streaming"
  nowSpinningAt DateTime? // when nowSpinning was last set
  spins        Spin[]
  skin         String?
  createdAt    DateTime @default(now())

  // Spotify OAuth
  spotifyId           String?
  spotifyAccessToken  String?
  spotifyRefreshToken String?
  spotifyTokenExpiry  DateTime?

  // Activity feed filter preferences
  feedPreferences     Json?

  collection   Collection[]
  logs         ListeningLog[]
  wantlist     Wantlist[]
  audioSetup   AudioSetup?
  mixes        Mix[]

  following    Follow[] @relation("follower")
  followers    Follow[] @relation("following")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // "spin", "follow", "now_spinning"
  fromId    String?
  logId     String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User  @relation(fields: [userId], references: [id])
}

model Album {
  id          String  @id @default(cuid())
  discogsId   String  @unique
  title       String
  artist      String
  releaseYear Int?
  coverUrl    String?
  label       String?
  genre       String?

  collection  Collection[]
  logs        ListeningLog[]
  wantlist    Wantlist[]
  mixItems    MixItem[]
}

model Spin {
  id        String   @id @default(cuid())
  userId    String
  logId     String
  createdAt DateTime @default(now())

  user      User         @relation(fields: [userId], references: [id])
  log       ListeningLog @relation(fields: [logId], references: [id])

  @@unique([userId, logId])
}

model Collection {
  id          String   @id @default(cuid())
  userId      String
  albumId     String
  condition   String?
  isFeatured  Boolean  @default(false)
  addedAt     DateTime @default(now())

  user        User  @relation(fields: [userId], references: [id])
  album       Album @relation(fields: [albumId], references: [id])

  @@unique([userId, albumId])
}

model ListeningLog {
  id       String   @id @default(cuid())
  userId   String
  albumId  String
  rating   Float?
  spins    Spin[]
  review   String?
  format   String?
  source       String   @default("physical") // "physical" | "streaming"
  autoImported Boolean  @default(false)      // true for Spotify auto-imports
  playedAt     DateTime @default(now())

  user     User  @relation(fields: [userId], references: [id])
  album    Album @relation(fields: [albumId], references: [id])
}

model Wantlist {
  id      String   @id @default(cuid())
  userId  String
  albumId String
  addedAt DateTime @default(now())

  user    User  @relation(fields: [userId], references: [id])
  album   Album @relation(fields: [albumId], references: [id])

  @@unique([userId, albumId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    User @relation("follower", fields: [followerId], references: [id])
  following   User @relation("following", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
}

model AudioSetup {
  id        String  @id @default(cuid())
  userId    String  @unique
  turntable String?
  preamp    String?
  speakers  String?
  photoUrl  String?

  user      User @relation(fields: [userId], references: [id])
}

model Mix {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?
  coverUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id])
  items       MixItem[]
}

model MixItem {
  id       String @id @default(cuid())
  mixId    String
  albumId  String
  position Int

  mix      Mix   @relation(fields: [mixId], references: [id], onDelete: Cascade)
  album    Album @relation(fields: [albumId], references: [id])

  @@unique([mixId, albumId])
  @@unique([mixId, position])
}
